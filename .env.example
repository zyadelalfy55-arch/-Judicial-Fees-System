NODE_ENV=development
APP_MODE=demo
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
# Replace with a private random value of at least 32 characters.
SESSION_SECRET=replace-this-with-a-private-random-secret-of-at-least-32-characters
LOG_LEVEL=info
DATABASE_PATH=./data/jfs.sqlite
# Production OIDC — unused in demo
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
CORS_ORIGINS=http://localhost:5173

# Set all three values for the first startup that creates the initial super admin.
# Remove them from the environment after the account is created.
BOOTSTRAP_SUPER_ADMIN_USERNAME=
BOOTSTRAP_SUPER_ADMIN_DISPLAY_NAME=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
